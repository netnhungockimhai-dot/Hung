--==================================================
-- 07. GOLDEN TRAIL
--==================================================

local function createGoldenTrailSegment(fromPosition, toPosition)
    local difference = toPosition - fromPosition
    local distance = difference.Magnitude

    if distance < GOLD_TRAIL_MIN_DISTANCE then
        return
    end

    local midpoint = (fromPosition + toPosition) / 2

    local segment = Instance.new("Part")
    segment.Name = "ByweeaGoldenTrailSegment"
    segment.Anchored = true
    segment.CanCollide = false
    segment.CanTouch = false
    segment.CanQuery = false
    segment.CastShadow = false
    segment.Material = Enum.Material.Neon
    segment.Color = LIGHT_GOLD
    segment.Transparency = 0.12

    segment.Size = Vector3.new(
        GOLD_TRAIL_WIDTH,
        0.12,
        distance + 0.15
    )

    segment.CFrame = CFrame.lookAt(midpoint, toPosition)
    segment.Parent = workspace

    local glow = Instance.new("PointLight")
    glow.Name = "GoldenTrailGlow"
    glow.Color = GOLD
    glow.Brightness = 0.65
    glow.Range = 5
    glow.Shadows = false
    glow.Parent = segment

    Debris:AddItem(segment, GOLD_TRAIL_LIFETIME)
end

local function updateGoldenTrail(position)
    local now = os.clock()

    if not lastTrailPosition then
        lastTrailPosition = position
        lastTrailTime = now
        return
    end

    if now - lastTrailTime < GOLD_TRAIL_INTERVAL then
        return
    end

    local previous = lastTrailPosition
    local distance = (position - previous).Magnitude

    lastTrailTime = now

    if distance >= GOLD_TRAIL_MIN_DISTANCE then
        createGoldenTrailSegment(previous, position)
        lastTrailPosition = position
    end
end

--==================================================
-- 08. CLEANUP FLIGHT
--==================================================

local function cleanupFlight()
    flying = false

    -- Hien lai tham cam tay
    setHeldCarpetVisible(true)

    resetKeys()

    -- Con cam Tool thi van giu tay phai dua ra truoc
    if not equipped then
        stopArmForce()
    end

    lastTrailPosition = nil
    lastTrailTime = 0

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    if trail then
        trail.Enabled = false
    end

    if linearVelocity then
        linearVelocity:Destroy()
        linearVelocity = nil
    end

    if alignOrientation then
        alignOrientation:Destroy()
        alignOrientation = nil
    end

    if attachment then
        attachment:Destroy()
        attachment = nil
    end

    if carpet then
        carpet:Destroy()
        carpet = nil
    end

    trail = nil

    if humanoid and humanoid.Parent then
        if savedAutoRotate ~= nil then
            humanoid.AutoRotate = savedAutoRotate
        end

        if savedPlatformStand ~= nil then
            humanoid.PlatformStand = savedPlatformStand
        end

        pcall(function()
            humanoid:ChangeState(
                Enum.HumanoidStateType.GettingUp
            )
        end)
    end

    if savedAnimate and savedAnimate.Parent then
        savedAnimate.Disabled = savedAnimateDisabled or false
    end

    savedAutoRotate = nil
    savedPlatformStand = nil
    savedAnimate = nil
    savedAnimateDisabled = nil
end

--==================================================
-- 09. START FLIGHT
--==================================================

local function startFlying()
    if flying or not equipped then
        return
    end

    character = player.Character

    humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    root = character
        and character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return
    end

    savedAutoRotate = humanoid.AutoRotate
    savedPlatformStand = humanoid.PlatformStand

    savedAnimate = character:FindFirstChild("Animate")

    if savedAnimate then
        savedAnimateDisabled = savedAnimate.Disabled
        savedAnimate.Disabled = true
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if animator then
        for _, track in ipairs(
            animator:GetPlayingAnimationTracks()
        ) do
            track:Stop(0)
        end
    end

    -- Dam bao tay phai dang bi ep (da bat tu luc cam Tool)
    if not armForced then
        startArmForce()
    end

    local success, result = pcall(createCarpet)

    if not success or not result then
        warn("[Byweea Carpet] Khong tao duoc tham:", result)
        cleanupFlight()
        return
    end

    attachment = Instance.new("Attachment")
    attachment.Name = "CarpetFlightAttachment"
    attachment.Parent = root

    linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Name = "CarpetFlightVelocity"
    linearVelocity.Attachment0 = attachment
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.VelocityConstraintMode =
        Enum.VelocityConstraintMode.Vector
    linearVelocity.ForceLimitsEnabled = false
    linearVelocity.VectorVelocity = Vector3.zero
    linearVelocity.Parent = root

    alignOrientation = Instance.new("AlignOrientation")
    alignOrientation.Name = "CarpetFlightRotation"
    alignOrientation.Mode =
        Enum.OrientationAlignmentMode.OneAttachment
    alignOrientation.Attachment0 = attachment
    alignOrientation.RigidityEnabled = false
    alignOrientation.Responsiveness = 100
    alignOrientation.MaxTorque = 1000000000
    alignOrientation.MaxAngularVelocity = 100

    -- Lay huong camera khi bat dau bay
    local camera = workspace.CurrentCamera
    local initialLook = camera and camera.CFrame.LookVector
        or root.CFrame.LookVector

    if initialLook.Magnitude > 0.001 then
        alignOrientation.CFrame = CFrame.lookAt(
            Vector3.zero,
            initialLook.Unit,
            camera and camera.CFrame.UpVector or Vector3.yAxis
        )
    end

    alignOrientation.Parent = root

    humanoid.AutoRotate = false
    humanoid.PlatformStand = true
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    flying = true

    -- An tham cam tay, dung tham bay thay the
    setHeldCarpetVisible(false)

    lastTrailPosition = nil
    lastTrailTime = 0

    applyArmPose()

    if trail then
        trail.Enabled = true
    end

    --==================================================
    -- 09A. FULL 3D FLIGHT LOOP
    --==================================================

    flyConnection = RunService.Heartbeat:Connect(function()
        if not flying then
            return
        end

        if not character or not character.Parent
            or not root or not root.Parent
            or not humanoid or humanoid.Health <= 0
            or not carpet or not carpet.Parent
            or not linearVelocity or not linearVelocity.Parent
            or not alignOrientation or not alignOrientation.Parent then

            cleanupFlight()
            return
        end

        local currentCamera = workspace.CurrentCamera

        if not currentCamera then
            return
        end

        local cameraCFrame = currentCamera.CFrame
        local cameraLook = cameraCFrame.LookVector.Unit
        local cameraRight = cameraCFrame.RightVector

        -- Nhan vat xoay theo huong camera 3D
        alignOrientation.CFrame = CFrame.lookAt(
            Vector3.zero,
            cameraLook,
            cameraCFrame.UpVector
        )

        -- Di chuyen theo camera
        local direction = Vector3.zero

        if keys.W or keys.Up then
            direction += cameraLook
        end

        if keys.S or keys.Down then
            direction -= cameraLook
        end

        if keys.D or keys.Right then
            direction += cameraRight
        end

        if keys.A or keys.Left then
            direction -= cameraRight
        end

        if direction.Magnitude > 1 then
            direction = direction.Unit
        end

        local vertical = 0

        if keys.Space then
            vertical += VERTICAL_SPEED
        end

        if keys.Shift then
            vertical -= VERTICAL_SPEED
        end

        linearVelocity.VectorVelocity = Vector3.new(
            direction.X * FLY_SPEED,
            direction.Y * FLY_SPEED + vertical,
            direction.Z * FLY_SPEED
        )

        -- Dat tham truoc nguc theo camera 3D
        local torso = getTorso()

        local chest = torso and torso.Position
            or (root.Position + Vector3.new(0, 0.5, 0))

        local carpetPosition =
            chest
            + cameraLook * CARPET_FORWARD_OFFSET
            + Vector3.new(0, CARPET_VERTICAL_OFFSET, 0)

        carpet.CFrame = CFrame.lookAt(
            carpetPosition,
            carpetPosition + cameraLook,
            cameraCFrame.UpVector
        ) * CFrame.Angles(math.rad(90), 0, 0)

        updateGoldenTrail(carpetPosition)
    end)
end

--==================================================
-- 10. CREATE TOOL + HELD CARPET HANDLE
--==================================================

local function createTool()
    if creatingTool then
        return
    end

    creatingTool = true

    local success, err = pcall(function()
        local backpack = player:WaitForChild("Backpack")

        -- Xoa Tool trung ten
        for _, container in ipairs({backpack, character}) do
            if container then
                for _, item in ipairs(container:GetChildren()) do
                    if item:IsA("Tool")
                        and item.Name == TOOL_NAME then
                        item:Destroy()
                    end
                end
            end
        end

        disconnectToolConnections()
        cleanupFlight()

        local newTool = Instance.new("Tool")
        newTool.Name = TOOL_NAME
        newTool.ToolTip = "Click to fly with the Golden Carpet"
        newTool.RequiresHandle = true
        newTool.CanBeDropped = false
        newTool.Enabled = true
        newTool.Grip = HELD_CARPET_GRIP

        -- Handle that Roblox uses to grip the Tool: invisible and non-collidable
        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = INVISIBLE_HANDLE_SIZE
        handle.Transparency = 1
        handle.Color = Color3.new(1, 1, 1)
        handle.Material = Enum.Material.SmoothPlastic
        handle.Anchored = false
        handle.CanCollide = false
        handle.CanTouch = false
        handle.CanQuery = false
        handle.Massless = true
        handle.CastShadow = false
        handle.Parent = newTool

        -- Separate visible carpet model welded to the invisible Tool Handle
        local heldCarpetPart = Instance.new("Part")
        heldCarpetPart.Name = "HeldGoldenCarpetVisual"
        heldCarpetPart.Size = HELD_CARPET_SIZE
        heldCarpetPart.Transparency = HELD_CARPET_VISIBLE and 0 or 1
        heldCarpetPart.Color = Color3.new(1, 1, 1)
        heldCarpetPart.Material = Enum.Material.SmoothPlastic
        heldCarpetPart.Anchored = false
        heldCarpetPart.CanCollide = false
        heldCarpetPart.CanTouch = false
        heldCarpetPart.CanQuery = false
        heldCarpetPart.Massless = true
        heldCarpetPart.CastShadow = false

        local handMesh = Instance.new("SpecialMesh")
        handMesh.Name = "GoldenCarpetMesh"
        handMesh.MeshType = Enum.MeshType.FileMesh
        handMesh.MeshId = CARPET_MESH_ID
        handMesh.TextureId = CARPET_TEXTURE_ID
        handMesh.Scale = HELD_CARPET_SCALE
        handMesh.VertexColor = Vector3.new(1, 1, 1)
        handMesh.Parent = heldCarpetPart

        local visualWeld = Instance.new("WeldConstraint")
        visualWeld.Name = "HeldCarpetVisualWeld"
        visualWeld.Part0 = handle
        visualWeld.Part1 = heldCarpetPart
        visualWeld.Parent = heldCarpetPart

        heldCarpetPart.Parent = newTool
        heldHandle = heldCarpetPart

        table.insert(
            toolConnections,
            newTool.Equipped:Connect(function()
                tool = newTool
                equipped = true
                character = player.Character

                humanoid = character
                    and character:FindFirstChildOfClass("Humanoid")

                root = character
                    and character:FindFirstChild("HumanoidRootPart")

                -- Cam Tool la tay phai dua ra truoc ngay
                startArmForce()
            end)
        )

        -- Click man hinh: bat / tat bay
        table.insert(
            toolConnections,
            newTool.Activated:Connect(function()
                if not equipped then
                    return
                end

                if flying then
                    cleanupFlight()
                else
                    startFlying()
                end
            end)
        )

        table.insert(
            toolConnections,
            newTool.Unequipped:Connect(function()
                equipped = false
                cleanupFlight()
                stopArmForce()

                -- Chi tu cam lai khi FORCE_EQUIP = true
                task.defer(forceEquipTool)
            end)
        )

        table.insert(
            toolConnections,
            newTool.Destroying:Connect(function()
                equipped = false
                cleanupFlight()
                stopArmForce()
                disconnectToolConnections()
                heldHandle = nil
            end)
        )

        -- Tool nam trong Backpack (hotbar), nguoi choi tu cam len
        newTool.Parent = backpack
        tool = newTool

        -- Chi tu cam ngay khi vua tao neu FORCE_EQUIP = true
        task.defer(forceEquipTool)
    end)

    creatingTool = false

    if not success then
        warn("[Byweea Carpet] Loi tao Tool:", err)
    end
end

--==================================================
-- 11. KEYBOARD INPUT
--==================================================

local keyMap = {
    [Enum.KeyCode.W] = "W",
    [Enum.KeyCode.A] = "A",
    [Enum.KeyCode.S] = "S",
    [Enum.KeyCode.D] = "D",

    [Enum.KeyCode.Up] = "Up",
    [Enum.KeyCode.Down] = "Down",
    [Enum.KeyCode.Left] = "Left",
    [Enum.KeyCode.Right] = "Right",

    [Enum.KeyCode.Space] = "Space",
    [Enum.KeyCode.LeftShift] = "Shift",
    [Enum.KeyCode.RightShift] = "Shift",
    [Enum.KeyCode.LeftControl] = "Shift",
}

inputBeganConnection = UserInputService.InputBegan:Connect(
    function(input, processed)
        if processed or not flying then
            return
        end

        local key = keyMap[input.KeyCode]

        if key then
            keys[key] = true
        end
    end
)

inputEndedConnection = UserInputService.InputEnded:Connect(
    function(input)
        local key = keyMap[input.KeyCode]

        if key then
            keys[key] = false
        end
    end
)

--==================================================
-- 12. RESPAWN HANDLING
--==================================================

local function onCharacterAdded(newCharacter)
    equipped = false
    cleanupFlight()
    stopArmForce()
    destroyInvisibleHandle()
    resetKeys()

    if diedConnection then
        diedConnection:Disconnect()
        diedConnection = nil
    end

    character = newCharacter
    humanoid = nil
    root = nil
    tool = nil
    heldHandle = nil

    task.spawn(function()
        local newHumanoid = newCharacter:WaitForChild(
            "Humanoid",
            10
        )

        if not newHumanoid
            or player.Character ~= newCharacter then
            return
        end

        humanoid = newHumanoid

        root = newCharacter:WaitForChild(
            "HumanoidRootPart",
            10
        )

        if not root or player.Character ~= newCharacter then
            return
        end

        diedConnection = humanoid.Died:Connect(function()
            equipped = false
            cleanupFlight()
            stopArmForce()
            destroyInvisibleHandle()
        end)

        -- Gan part Handle invisible len tay phai (cho R15 doi tay load xong)
        if humanoid.RigType == Enum.HumanoidRigType.R15 then
            newCharacter:WaitForChild("RightHand", 10)
        else
            newCharacter:WaitForChild("Right Arm", 10)
        end

        if player.Character ~= newCharacter then
            return
        end

        createInvisibleHandle()
        createTool()
    end)
end

characterConnection = player.CharacterAdded:Connect(
    onCharacterAdded
)

if player.Character then
    onCharacterAdded(player.Character)
end

--==================================================
-- 13. SCRIPT CLEANUP
--==================================================

script.Destroying:Connect(function()
    equipped = false
    cleanupFlight()
    stopArmForce()
    destroyInvisibleHandle()
    disconnectToolConnections()

    -- Luon tra hotbar ve nhu cu
    task.spawn(lockBackpackGui, false)

    if diedConnection then
        diedConnection:Disconnect()
        diedConnection = nil
    end

    if characterConnection then
        characterConnection:Disconnect()
        characterConnection = nil
    end

    if inputBeganConnection then
        inputBeganConnection:Disconnect()
        inputBeganConnection = nil
    end

    if inputEndedConnection then
        inputEndedConnection:Disconnect()
        inputEndedConnection = nil
    end
end)
