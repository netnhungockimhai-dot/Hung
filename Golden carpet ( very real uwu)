--==================================================
-- 04. HELPERS
--==================================================

local function resetKeys()
    for key in pairs(keys) do
        keys[key] = false
    end
end

local function disconnectToolConnections()
    for _, connection in ipairs(toolConnections) do
        connection:Disconnect()
    end

    table.clear(toolConnections)
end

local function getTorso()
    if not character then
        return nil
    end

    return character:FindFirstChild("Torso")
        or character:FindFirstChild("UpperTorso")
end

local function setHeldCarpetVisible(visible)
    if heldHandle and heldHandle.Parent then
        heldHandle.Transparency =
            (visible and HELD_CARPET_VISIBLE) and 0 or 1
    end
end

--==================================================
-- 04A. INVISIBLE HANDLE TREN TAY PHAI
--==================================================

local function destroyInvisibleHandle()
    if invisibleHandle then
        invisibleHandle:Destroy()
        invisibleHandle = nil
    end
end

local function createInvisibleHandle()
    destroyInvisibleHandle()

    if not character or not humanoid then
        return
    end

    local isR6 = humanoid.RigType == Enum.HumanoidRigType.R6

    local hand = isR6
        and character:FindFirstChild("Right Arm")
        or character:FindFirstChild("RightHand")

    if not hand then
        warn("[Byweea Carpet] Khong tim thay tay phai de gan Handle invisible.")
        return
    end

    local part = Instance.new("Part")
    part.Name = INVISIBLE_HANDLE_NAME
    part.Size = INVISIBLE_HANDLE_SIZE
    part.Transparency = 1
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Massless = true
    part.Anchored = false
    part.CFrame = hand.CFrame
        * (isR6 and R6_INVISIBLE_HANDLE_OFFSET
            or R15_INVISIBLE_HANDLE_OFFSET)

    local weld = Instance.new("Weld")
    weld.Name = "ByweeaInvisibleHandleWeld"
    weld.Part0 = hand
    weld.Part1 = part
    weld.C0 = isR6 and R6_INVISIBLE_HANDLE_OFFSET
        or R15_INVISIBLE_HANDLE_OFFSET
    weld.Parent = part

    part.Parent = character

    invisibleHandle = part
end

-- Chi chay khi FORCE_EQUIP = true: dang o Backpack thi cam lai ngay
local function forceEquipTool()
    if not FORCE_EQUIP then
        return
    end

    if not tool or not tool.Parent then
        return
    end

    if not character or tool.Parent == character then
        return
    end

    if not humanoid or humanoid.Health <= 0 then
        return
    end

    pcall(function()
        humanoid:EquipTool(tool)
    end)
end

