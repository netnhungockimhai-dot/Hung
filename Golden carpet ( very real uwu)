task.spawn(lockBackpackGui, FORCE_EQUIP)

--==================================================
-- 05. RIGHT ARM - FORCE POSE R6 / R15
--     (bat buoc khi cam Tool + khi bay)
--==================================================

local function prepareHands()
    rightShoulder = nil
    rightElbow = nil
    rightWrist = nil
    currentArmPose = CFrame.identity

    if not character or not humanoid then
        return
    end

    for _, desc in ipairs(character:GetDescendants()) do
        if desc:IsA("Motor6D") then
            if desc.Name == "RightShoulder"
                or desc.Name == "Right Shoulder" then

                rightShoulder = desc
            elseif desc.Name == "RightElbow" then
                rightElbow = desc
            elseif desc.Name == "RightWrist" then
                rightWrist = desc
            end
        end
    end

    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        currentArmPose = R6_ARM_POSE
    else
        currentArmPose = R15_ARM_POSE
    end
end

local function applyArmPose()
    if not armForced then
        return
    end

    if rightShoulder and rightShoulder.Parent then
        rightShoulder.Transform = currentArmPose
    end

    -- R15: giu khuyu tay va co tay thang
    if rightElbow and rightElbow.Parent then
        rightElbow.Transform = CFrame.identity
    end

    if rightWrist and rightWrist.Parent then
        rightWrist.Transform = CFrame.identity
    end
end

local function stopArmForce()
    armForced = false

    RunService:UnbindFromRenderStep(ARM_BIND_NAME)

    if armHeartbeatConnection then
        armHeartbeatConnection:Disconnect()
        armHeartbeatConnection = nil
    end

    -- Tra tay ve binh thuong
    if rightShoulder and rightShoulder.Parent then
        rightShoulder.Transform = CFrame.identity
    end

    if rightElbow and rightElbow.Parent then
        rightElbow.Transform = CFrame.identity
    end

    if rightWrist and rightWrist.Parent then
        rightWrist.Transform = CFrame.identity
    end

    rightShoulder = nil
    rightElbow = nil
    rightWrist = nil
    currentArmPose = CFrame.identity
end

local function startArmForce()
    stopArmForce()
    prepareHands()

    if not rightShoulder then
        warn("[Byweea Carpet] Khong tim thay khop vai phai.")
        return
    end

    armForced = true

    -- Ap dung lai tu the sau khi Animator cap nhat khop,
    -- giup animation mac dinh it ghi de len tay hon.
    RunService:UnbindFromRenderStep(ARM_BIND_NAME)

    armHeartbeatConnection = RunService.PreSimulation:Connect(function()
        if armForced then
            applyArmPose()
        end
    end)

    applyArmPose()
end

