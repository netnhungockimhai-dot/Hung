
-- [[ Byweea cute💗 | Rainbow Gravity Coil + Rainbow Trail ]] --

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Configuration
local TOOL_NAME = "Byweea cute💗"
local BOING_SOUND_ID = "rbxassetid://16619553"

local JUMP_POWER = 103
local DEFAULT_JUMP_POWER = 50
local FALL_FORCE = 0.5

-- Coil appearance
local COIL_RADIUS = 0.65
local COIL_TURNS = 5
local COIL_SEGMENTS_PER_TURN = 40
local COIL_THICKNESS = 0.075
local COIL_HEIGHT = 2.5

-- Rainbow settings
local RAINBOW_SPEED = 1.5

-- Trail settings
local TRAIL_LIFETIME = 0.6
local TRAIL_WIDTH = 0.8

local playerStates = {}

-- Rainbow color
local function rainbowColor(offset)
    return Color3.fromHSV(
        (os.clock() * RAINBOW_SPEED + offset) % 1,
        1,
        1
    )
end

-- Cleanup effects
local function cleanupEffects(state)
    if state.jumpConnection then
        state.jumpConnection:Disconnect()
        state.jumpConnection = nil
    end

    if state.fallConnection then
        state.fallConnection:Disconnect()
        state.fallConnection = nil
    end

    if state.colorConnection then
        state.colorConnection:Disconnect()
        state.colorConnection = nil
    end

    if state.force then
        state.force:Destroy()
        state.force = nil
    end

    if state.attachment then
        state.attachment:Destroy()
        state.attachment = nil
    end
end

-- Create coil model
local function createCoilModel(tool)
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Shape = Enum.PartType.Ball
    handle.Size = Vector3.new(0.25, 0.25, 0.25)
    handle.Transparency = 1
    handle.CanCollide = false
    handle.CanTouch = false
    handle.CanQuery = false
    handle.Massless = true
    handle.Parent = tool

    local segments = {}
    local totalSegments = COIL_TURNS * COIL_SEGMENTS_PER_TURN
    local totalAngle = COIL_TURNS * math.pi * 2
    local tailPosition

    for i = 0, totalSegments - 1 do
        local t1 = i / totalSegments
        local t2 = (i + 1) / totalSegments

        local angle1 = t1 * totalAngle
        local angle2 = t2 * totalAngle

        local p1 = Vector3.new(
            math.cos(angle1) * COIL_RADIUS,
            math.sin(angle1) * COIL_RADIUS,
            (t1 - 0.5) * COIL_HEIGHT
        )

        local p2 = Vector3.new(
            math.cos(angle2) * COIL_RADIUS,
            math.sin(angle2) * COIL_RADIUS,
            (t2 - 0.5) * COIL_HEIGHT
        )

        local direction = p2 - p1
        local midpoint = (p1 + p2) / 2

        local segment = Instance.new("Part")
        segment.Name = "CoilSegment"
        segment.Shape = Enum.PartType.Cylinder
        segment.Size = Vector3.new(
            direction.Magnitude + 0.015,
            COIL_THICKNESS,
            COIL_THICKNESS
        )

        segment.Color = rainbowColor(t1)
        segment.Material = Enum.Material.Neon
        segment.CanCollide = false
        segment.CanTouch = false
        segment.CanQuery = false
        segment.Massless = true

        segment.CFrame = CFrame.new(midpoint)
            * CFrame.fromRotationBetweenVectors(
                Vector3.new(1, 0, 0),
                direction.Unit
            )

        segment.Parent = tool

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = handle
        weld.Part1 = segment
        weld.Parent = segment

        table.insert(segments, {
            part = segment,
            offset = t1
        })

        tailPosition = p2
    end

    return handle, tailPosition, segments
end

-- Create rainbow trail
local function createRainbowTrail(handle, tailPosition)
    local a0 = Instance.new("Attachment")
    a0.Name = "RainbowTrailStart"
    a0.Position = tailPosition
    a0.Parent = handle

    local a1 = Instance.new("Attachment")
    a1.Name = "RainbowTrailEnd"
    a1.Position = tailPosition + Vector3.new(0, 0, -0.8)
    a1.Parent = handle

    local trail = Instance.new("Trail")
    trail.Name = "ByweeaRainbowTrail"
    trail.Attachment0 = a0
    trail.Attachment1 = a1

    trail.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 127, 0)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 170, 255)),
        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(100, 0, 255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 170))
    })

    trail.Lifetime = TRAIL_LIFETIME
    trail.MinLength = 0.03

    trail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, TRAIL_WIDTH),
        NumberSequenceKeypoint.new(1, 0)
    })

    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.05),
        NumberSequenceKeypoint.new(1, 1)
    })

    trail.FaceCamera = true
    trail.LightEmission = 1
    trail.Enabled = false
    trail.Parent = handle

    return trail
end

-- Light fall effect
local function enableLightFall(player, state)
    if state.fallConnection then
        state.fallConnection:Disconnect()
        state.fallConnection = nil
    end

    if state.force then
        state.force:Destroy()
        state.force = nil
    end

    if state.attachment then
        state.attachment:Destroy()
        state.attachment = nil
    end

    local character = player.Character
    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    local attachment = Instance.new("Attachment")
    attachment.Name = "ByweeaFallAttachment"
    attachment.Parent = root
    state.attachment = attachment

    local force = Instance.new("VectorForce")
    force.Name = "ByweeaFallForce"
    force.Attachment0 = attachment
    force.RelativeTo = Enum.ActuatorRelativeTo.World
    force.ApplyAtCenterOfMass = true
    force.Parent = root
    state.force = force

    state.fallConnection = RunService.Heartbeat:Connect(function()
        if not root.Parent or not force.Parent then
            if state.fallConnection then
                state.fallConnection:Disconnect()
                state.fallConnection = nil
            end
            return
        end

        if root.AssemblyLinearVelocity.Y < 0 then
            force.Force = Vector3.new(
                0,
                root.AssemblyMass * workspace.Gravity * FALL_FORCE,
                0
            )
        else
            force.Force = Vector3.zero
        end
    end)
end

-- Create gravity coil
local function createGravityCoil(player)
    local backpack = player:WaitForChild("Backpack")

    local oldTool = backpack:FindFirstChild(TOOL_NAME)
    if oldTool then
        oldTool:Destroy()
    end

    if player.Character then
        local equipped = player.Character:FindFirstChild(TOOL_NAME)
        if equipped then
            equipped:Destroy()
        end
    end

    local tool = Instance.new("Tool")
    tool.Name = TOOL_NAME
    tool.ToolTip = "Byweea Rainbow Gravity Coil"
    tool.RequiresHandle = true
    tool.CanBeDropped = false
    tool.Grip = CFrame.new(0, 0, -0.25)
        * CFrame.Angles(0, 0, math.rad(90))

    local handle, tailPosition, segments = createCoilModel(tool)
    local trail = createRainbowTrail(handle, tailPosition)

    local sound = Instance.new("Sound")
    sound.Name = "BoingSound"
    sound.SoundId = BOING_SOUND_ID
    sound.Volume = 0.6
    sound.Looped = false
    sound.Parent = handle

    local state = {
        tool = tool,
        trail = trail,
        segments = segments,
        isEquipped = false,
        originalJumpPower = nil,
        originalUseJumpPower = nil
    }

    playerStates[player] = state

    -- Rainbow animation ONLY while equipped
    state.colorConnection = RunService.Heartbeat:Connect(function()
        if not tool.Parent then
            if state.colorConnection then
                state.colorConnection:Disconnect()
                state.colorConnection = nil
            end
            return
        end

        if not state.isEquipped then
            return
        end

        for _, item in ipairs(segments) do
            if item.part.Parent then
                item.part.Color = rainbowColor(item.offset)
            end
        end

        local hue = (os.clock() * RAINBOW_SPEED) % 1

        trail.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(
                0,
                Color3.fromHSV(hue, 1, 1)
            ),
            ColorSequenceKeypoint.new(
                0.5,
                Color3.fromHSV((hue + 0.33) % 1, 1, 1)
            ),
            ColorSequenceKeypoint.new(
                1,
                Color3.fromHSV((hue + 0.67) % 1, 1, 1)
            )
        })
    end)

    -- Equip
    tool.Equipped:Connect(function()
        state.isEquipped = true

        local character = player.Character
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")

        if not humanoid then
            state.isEquipped = false
            return
        end

        state.originalJumpPower = humanoid.JumpPower
        state.originalUseJumpPower = humanoid.UseJumpPower

        humanoid.UseJumpPower = true
        humanoid.JumpPower = JUMP_POWER

        trail.Enabled = true
        enableLightFall(player, state)

        if state.jumpConnection then
            state.jumpConnection:Disconnect()
        end

        state.jumpConnection = humanoid.Jumping:Connect(function(isJumping)
            if isJumping and sound.Parent then
                sound:Stop()
                sound.TimePosition = 0
                sound:Play()
            end
        end)
    end)

    -- Unequip
    tool.Unequipped:Connect(function()
        state.isEquipped = false

        local character = player.Character
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            if state.originalJumpPower ~= nil then
                humanoid.JumpPower = state.originalJumpPower
            else
                humanoid.JumpPower = DEFAULT_JUMP_POWER
            end

            if state.originalUseJumpPower ~= nil then
                humanoid.UseJumpPower = state.originalUseJumpPower
            end
        end

        trail.Enabled = false
        cleanupEffects(state)
    end)

    tool.Destroying:Connect(function()
        state.isEquipped = false
        trail.Enabled = false
        cleanupEffects(state)
    end)

    tool.Parent = backpack
end

-- Player setup
local function setupPlayer(player)
    player.CharacterAdded:Connect(function()
        local oldState = playerStates[player]

        if oldState then
            cleanupEffects(oldState)
            playerStates[player] = nil
        end

        task.wait(1)

        if player.Parent then
            createGravityCoil(player)
        end
    end)

    if player.Character then
        task.spawn(function()
            task.wait(1)

            if player.Parent then
                createGravityCoil(player)
            end
        end)
    end
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(player)
    local state = playerStates[player]

    if state then
        cleanupEffects(state)
        playerStates[player] = nil
    end
end)

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end
