local function createTool()
    if creatingTool then
        return
    end

    creatingTool = true

    local success, err = pcall(function()
        local backpack = player:WaitForChild("Backpack")

        for _, container in ipairs({backpack, character}) do
            if container then
                for _, item in ipairs(container:GetChildren()) do
                    if item:IsA("Tool") and item.Name == TOOL_NAME then
                        item:Destroy()
                    end
                end
            end
        end

        disconnectToolConnections()
        cleanupFlight()

        local newTool = Instance.new("Tool")
        newTool.Name = TOOL_NAME
        newTool.ToolTip = "Click to fly with the Golden Carpet"
        newTool.RequiresHandle = true
        newTool.CanBeDropped = false
        newTool.Enabled = true
        newTool.Grip = HELD_CARPET_GRIP

        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = INVISIBLE_HANDLE_SIZE
        handle.Transparency = 1
        handle.Color = Color3.new(1, 1, 1)
        handle.Material = Enum.Material.SmoothPlastic
        handle.Anchored = false
        handle.CanCollide = false
        handle.CanTouch = false
        handle.CanQuery = false
        handle.Massless = true
        handle.CastShadow = false
        handle.Parent = newTool

        local heldCarpetPart = Instance.new("Part")
        heldCarpetPart.Name = "HeldGoldenCarpetVisual"
        heldCarpetPart.Size = HELD_CARPET_SIZE

        heldCarpetPart.Transparency =
            HELD_CARPET_VISIBLE and 0 or 1

        heldCarpetPart.Color = Color3.new(1, 1, 1)
        heldCarpetPart.Material = Enum.Material.SmoothPlastic
        heldCarpetPart.Anchored = false
        heldCarpetPart.CanCollide = false
        heldCarpetPart.CanTouch = false
        heldCarpetPart.CanQuery = false
        heldCarpetPart.Massless = true
        heldCarpetPart.CastShadow = false

        local handMesh = Instance.new("SpecialMesh")
        handMesh.Name = "GoldenCarpetMesh"
        handMesh.MeshType = Enum.MeshType.FileMesh
        handMesh.MeshId = CARPET_MESH_ID
        handMesh.TextureId = CARPET_TEXTURE_ID
        handMesh.Scale = HELD_CARPET_SCALE
        handMesh.VertexColor = Vector3.new(1, 1, 1)
        handMesh.Parent = heldCarpetPart

        local visualWeld = Instance.new("WeldConstraint")
        visualWeld.Name = "HeldCarpetVisualWeld"
        visualWeld.Part0 = handle
        visualWeld.Part1 = heldCarpetPart
        visualWeld.Parent = heldCarpetPart

        heldCarpetPart.Parent = newTool
        heldHandle = heldCarpetPart

        table.insert(
            toolConnections,
            newTool.Equipped:Connect(function()
                tool = newTool
                equipped = true

                character = player.Character

                humanoid = character
                    and character:FindFirstChildOfClass("Humanoid")

                root = character
                    and character:FindFirstChild("HumanoidRootPart")

                startArmForce()
            end)
        )

        table.insert(
            toolConnections,
            newTool.Activated:Connect(function()
                if not equipped then
                    return
                end

                if flying then
                    cleanupFlight()
                else
                    startFlying()
                end
            end)
        )

        table.insert(
            toolConnections,
            newTool.Unequipped:Connect(function()
                equipped = false

                cleanupFlight()
                stopArmForce()

                task.defer(forceEquipTool)
            end)
        )

        table.insert(
            toolConnections,
            newTool.Destroying:Connect(function()
                equipped = false

                cleanupFlight()
                stopArmForce()

                heldHandle = nil
            end)
        )

        newTool.Parent = backpack
        tool = newTool

        task.defer(forceEquipTool)
    end)

    creatingTool = false

    if not success then
        warn("[Byweea Carpet] Loi tao Tool:", err)
    end
end

