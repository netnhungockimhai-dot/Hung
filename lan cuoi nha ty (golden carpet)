local function cleanupFlight()
    flying = false

    setHeldCarpetVisible(true)
    resetKeys()

    if not equipped then
        stopArmForce()
    end

    lastTrailPosition = nil
    lastTrailTime = 0

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    if trail then
        trail.Enabled = false
    end

    if linearVelocity then
        linearVelocity:Destroy()
        linearVelocity = nil
    end

    if alignOrientation then
        alignOrientation:Destroy()
        alignOrientation = nil
    end

    if attachment then
        attachment:Destroy()
        attachment = nil
    end

    if carpet then
        carpet:Destroy()
        carpet = nil
    end

    trail = nil

    if humanoid and humanoid.Parent then
        if savedAutoRotate ~= nil then
            humanoid.AutoRotate = savedAutoRotate
        end

        if savedPlatformStand ~= nil then
            humanoid.PlatformStand = savedPlatformStand
        end

        pcall(function()
            humanoid:ChangeState(
                Enum.HumanoidStateType.GettingUp
            )
        end)
    end

    if savedAnimate and savedAnimate.Parent then
        savedAnimate.Disabled = savedAnimateDisabled or false
    end

    savedAutoRotate = nil
    savedPlatformStand = nil
    savedAnimate = nil
    savedAnimateDisabled = nil
end

--==================================================
-- 09. START FLIGHT
--==================================================

local function startFlying()
    if flying or not equipped then
        return
    end

    character = player.Character

    humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    root = character
        and character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return
    end

    savedAutoRotate = humanoid.AutoRotate
    savedPlatformStand = humanoid.PlatformStand

    savedAnimate = character:FindFirstChild("Animate")

    if savedAnimate then
        savedAnimateDisabled = savedAnimate.Disabled
        savedAnimate.Disabled = true
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end

    -- Refresh the arm joints before flight starts.
    startArmForce()

    local success, result = pcall(createCarpet)

    if not success or not result then
        warn("[Byweea Carpet] Khong tao duoc tham:", result)
        cleanupFlight()
        return
    end

    attachment = Instance.new("Attachment")
    attachment.Name = "CarpetFlightAttachment"
    attachment.Parent = root

    linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Name = "CarpetFlightVelocity"
    linearVelocity.Attachment0 = attachment
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.VelocityConstraintMode =
        Enum.VelocityConstraintMode.Vector
    linearVelocity.ForceLimitsEnabled = false
    linearVelocity.VectorVelocity = Vector3.zero
    linearVelocity.Parent = root

    alignOrientation = Instance.new("AlignOrientation")
    alignOrientation.Name = "CarpetFlightRotation"
    alignOrientation.Mode =
        Enum.OrientationAlignmentMode.OneAttachment
    alignOrientation.Attachment0 = attachment
    alignOrientation.RigidityEnabled = false
    alignOrientation.Responsiveness = 100
    alignOrientation.MaxTorque = 1000000000
    alignOrientation.MaxAngularVelocity = 100

    local camera = workspace.CurrentCamera

    local initialLook = camera
        and camera.CFrame.LookVector
        or root.CFrame.LookVector

    if initialLook.Magnitude > 0.001 then
        alignOrientation.CFrame = CFrame.lookAt(
            Vector3.zero,
            initialLook.Unit,
            camera and camera.CFrame.UpVector or Vector3.yAxis
        )
    end

    alignOrientation.Parent = root

    humanoid.AutoRotate = false
    humanoid.PlatformStand = true

    humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    flying = true
    setHeldCarpetVisible(false)

    lastTrailPosition = nil
    lastTrailTime = 0

    applyArmPose()

    if trail then
        trail.Enabled = true
    end

    --==================================================
    -- 09A. FULL CAMERA 3D FLIGHT LOOP
    --==================================================

    flyConnection = RunService.Heartbeat:Connect(function()
        if not flying then
            return
        end

        if not character or not character.Parent
            or not root or not root.Parent
            or not humanoid or humanoid.Health <= 0
            or not carpet or not carpet.Parent
            or not linearVelocity or not linearVelocity.Parent
            or not alignOrientation or not alignOrientation.Parent then

            cleanupFlight()
            return
        end

        local currentCamera = workspace.CurrentCamera

        if not currentCamera then
            return
        end

        local cameraCFrame = currentCamera.CFrame
        local cameraLook = cameraCFrame.LookVector.Unit
        local cameraRight = cameraCFrame.RightVector

        alignOrientation.CFrame = CFrame.lookAt(
            Vector3.zero,
            cameraLook,
            cameraCFrame.UpVector
        )

        local direction = Vector3.zero

        if keys.W or keys.Up then
            direction += cameraLook
        end

        if keys.S or keys.Down then
            direction -= cameraLook
        end

        if keys.D or keys.Right then
            direction += cameraRight
        end

        if keys.A or keys.Left then
            direction -= cameraRight
        end

        if direction.Magnitude > 1 then
            direction = direction.Unit
        end

        local vertical = 0

        if keys.Space then
            vertical += VERTICAL_SPEED
        end

        if keys.Shift then
            vertical -= VERTICAL_SPEED
        end

        linearVelocity.VectorVelocity = Vector3.new(
            direction.X * FLY_SPEED,
            direction.Y * FLY_SPEED + vertical,
            direction.Z * FLY_SPEED
        )

        local torso = getTorso()

        local chest = torso and torso.Position
            or (root.Position + Vector3.new(0, 0.5, 0))

        local carpetPosition =
            chest
            + cameraLook * CARPET_FORWARD_OFFSET
            + Vector3.new(0, CARPET_VERTICAL_OFFSET, 0)

        carpet.CFrame = CFrame.lookAt(
            carpetPosition,
            carpetPosition + cameraLook,
            cameraCFrame.UpVector
        ) * CFrame.Angles(math.rad(90), 0, 0)

        updateGoldenTrail(carpetPosition)
    end)
end

