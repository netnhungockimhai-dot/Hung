--==================================================
-- 05. RIGHT ARM POSE FIX
-- Uses Motor6D.C0 and reapplies it every render frame.
--==================================================

local function findMotor(parent, names)
    if not parent then
        return nil
    end

    for _, name in ipairs(names) do
        local motor = parent:FindFirstChild(name, true)

        if motor and motor:IsA("Motor6D") then
            return motor
        end
    end

    return nil
end

local function prepareHands()
    rightShoulder = nil
    rightElbow = nil
    rightWrist = nil

    originalShoulderC0 = nil
    originalElbowC0 = nil
    originalWristC0 = nil

    if not character or not humanoid then
        return false
    end

    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local torso = character:FindFirstChild("Torso")

        rightShoulder = findMotor(
            torso,
            {"Right Shoulder", "RightShoulder"}
        )
    else
        local upperTorso = character:FindFirstChild("UpperTorso")

        rightShoulder = findMotor(
            upperTorso,
            {"RightShoulder", "Right Shoulder"}
        )

        rightElbow = findMotor(
            character,
            {"RightElbow", "Right Elbow"}
        )

        rightWrist = findMotor(
            character,
            {"RightWrist", "Right Wrist"}
        )
    end

    if not rightShoulder then
        warn("[Byweea Carpet] Khong tim thay khop vai phai.")
        return false
    end

    originalShoulderC0 = rightShoulder.C0

    if rightElbow then
        originalElbowC0 = rightElbow.C0
    end

    if rightWrist then
        originalWristC0 = rightWrist.C0
    end

    return true
end

local function applyArmPose()
    if not armForced
        or not humanoid
        or not rightShoulder
        or not rightShoulder.Parent
        or not originalShoulderC0 then
        return
    end

    local angle

    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        angle = R6_ARM_ANGLE
    else
        angle = R15_ARM_ANGLE
    end

    -- Rebuild from the saved original C0 every frame.
    -- This prevents the angle from accumulating.
    rightShoulder.C0 =
        originalShoulderC0
        * CFrame.Angles(angle, 0, 0)

    -- Keep the lower arm joints at their original joint offsets.
    -- The Animator can still animate their Transform values.
    if rightElbow
        and rightElbow.Parent
        and originalElbowC0 then
        rightElbow.C0 = originalElbowC0
    end

    if rightWrist
        and rightWrist.Parent
        and originalWristC0 then
        rightWrist.C0 = originalWristC0
    end
end

local function stopArmForce()
    armForced = false

    RunService:UnbindFromRenderStep(ARM_BIND_NAME)

    -- Restore the original shoulder position.
    if rightShoulder and rightShoulder.Parent then
        if originalShoulderC0 then
            rightShoulder.C0 = originalShoulderC0
        end
    end

    if rightElbow and rightElbow.Parent then
        if originalElbowC0 then
            rightElbow.C0 = originalElbowC0
        end
    end

    if rightWrist and rightWrist.Parent then
        if originalWristC0 then
            rightWrist.C0 = originalWristC0
        end
    end

    rightShoulder = nil
    rightElbow = nil
    rightWrist = nil

    originalShoulderC0 = nil
    originalElbowC0 = nil
    originalWristC0 = nil
end

local function startArmForce()
    stopArmForce()

    if not prepareHands() then
        return
    end

    armForced = true

    RunService:BindToRenderStep(
        ARM_BIND_NAME,
        Enum.RenderPriority.Last.Value,
        function()
            if armForced then
                applyArmPose()
            end
        end
    )

    applyArmPose()
end

