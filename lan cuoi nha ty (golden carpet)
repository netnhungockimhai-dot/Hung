inputBeganConnection = UserInputService.InputBegan:Connect(
    function(input, processed)
        if processed or not flying then
            return
        end

        local key = keyMap[input.KeyCode]

        if key then
            keys[key] = true
        end
    end
)

inputEndedConnection = UserInputService.InputEnded:Connect(
    function(input)
        local key = keyMap[input.KeyCode]

        if key then
            keys[key] = false
        end
    end
)

--==================================================
-- 12. RESPAWN HANDLING
--==================================================

local function onCharacterAdded(newCharacter)
    equipped = false

    cleanupFlight()
    stopArmForce()
    destroyInvisibleHandle()
    resetKeys()

    if diedConnection then
        diedConnection:Disconnect()
        diedConnection = nil
    end

    character = newCharacter
    humanoid = nil
    root = nil
    tool = nil
    heldHandle = nil

    task.spawn(function()
        local newHumanoid =
            newCharacter:WaitForChild("Humanoid", 10)

        if not newHumanoid
            or player.Character ~= newCharacter then
            return
        end

        humanoid = newHumanoid

        root = newCharacter:WaitForChild(
            "HumanoidRootPart",
            10
        )

        if not root or player.Character ~= newCharacter then
            return
        end

        diedConnection = humanoid.Died:Connect(function()
            equipped = false

            cleanupFlight()
            stopArmForce()
            destroyInvisibleHandle()
        end)

        if humanoid.RigType == Enum.HumanoidRigType.R15 then
            newCharacter:WaitForChild("RightHand", 10)
        else
            newCharacter:WaitForChild("Right Arm", 10)
        end

        if player.Character ~= newCharacter then
            return
        end

        createInvisibleHandle()
        createTool()
    end)
end

characterConnection =
    player.CharacterAdded:Connect(onCharacterAdded)

if player.Character then
    onCharacterAdded(player.Character)
end

--==================================================
-- 13. SCRIPT CLEANUP
--==================================================

script.Destroying:Connect(function()
    equipped = false

    cleanupFlight()
    stopArmForce()
    destroyInvisibleHandle()
    disconnectToolConnections()

    task.spawn(lockBackpackGui, false)

    if diedConnection then
        diedConnection:Disconnect()
        diedConnection = nil
    end

    if characterConnection then
        characterConnection:Disconnect()
        characterConnection = nil
    end

    if inputBeganConnection then
        inputBeganConnection:Disconnect()
        inputBeganConnection = nil
    end

    if inputEndedConnection then
        inputEndedConnection:Disconnect()
        inputEndedConnection = nil
    end
end)
